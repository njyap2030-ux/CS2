tasks = []

while True:
    print("\n=== Assignment Tracker ===")
    print("1 Add  2 Show  3 Done  4 Delete  5 Exit")
    choice = input("Choose: ")

    if choice == "1":
        name = input("Task name: ")
        deadline = input("Deadline: ")
        if name and deadline:
            tasks.append([name, deadline, False])

    elif choice == "2":
        if not tasks:
            print("No tasks.")
        else:
            for i, t in enumerate(tasks, 1):
                status = "Done" if t[2] else "Not Done"
                print(f"{i}. {t[0]} - {t[1]} - {status}")

    elif choice == "3":
        if tasks:
            num = input("Task number done: ")
            if num.isdigit() and 1 <= int(num) <= len(tasks):
                tasks[int(num)-1][2] = True

    elif choice == "4":
        if tasks:
            num = input("Task number delete: ")
            if num.isdigit() and 1 <= int(num) <= len(tasks):
                tasks.pop(int(num)-1)

    elif choice == "5":
        break
